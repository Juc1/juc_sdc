{#
/**
 * @file
 * Component template for Group.
 *
 * Inherited from byte_theme/components/group with enhancements:
 * - Added 'responsive-md' ('flex-col md:flex-row') and 'responsive-lg' ('flex-col lg:flex-row')
 *   to flexDirection variants to allow vertical stacking on mobile devices and horizontal
 *   alignment on desktop screens.
 * - Added support for custom HTML attributes via Drupal create_attribute().
 */
#}

{% set group =
  html_cva(
    base: ['flex', 'bg-none'],
    variants: {
      flexDirection: {
        column: 'flex-col',
        row: 'flex-row',
        'responsive-md': 'flex-col md:flex-row',
        'responsive-lg': 'flex-col lg:flex-row',
        'column-reverse': 'flex-col-reverse',
        'row-reverse': 'flex-row-reverse'
      },
      groupAlign: {
        start: 'items-start justify-start',
        center: 'items-center justify-center',
        end: 'items-end justify-end'
      },
      flexAlign: {
        start: 'self-start',
        center: 'self-center',
        end: 'self-end'
      },
      flexGap: {
        sm: 'gap-2',
        md: 'gap-4',
        lg: 'gap-8',
        xl: 'gap-16'
      },
      radius: {
        sm: 'rounded-sm',
        md: 'rounded-md',
        lg: 'rounded-lg',
        xl: 'rounded-xl'
      },
      padding: {
        sm: 'p-4',
        md: 'p-8',
        lg: 'p-16',
        xl: 'p-32'
      },
      background: {
        primary: 'bg-primary',
        secondary: 'bg-secondary',
        accent: 'bg-accent'
      }
    }
  )
%}

{% set group_classes =
  group.apply({
    flexDirection: flex_direction,
    groupAlign: items_align|default('start'),
    flexAlign: flex_align|default('center'),
    flexGap: flex_gap,
    radius: radius,
    padding: padding,
    background: background
  })
%}

{% set group_attributes = group_attributes|default(create_attribute()) %}

<div {{ group_attributes.addClass(group_classes) }}>
  {% block group_slot %}

  {% endblock %}
</div>
